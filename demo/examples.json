  {
    "id": "generated-file-native-only",
    "title": "generated.file & generated.file_storage \u2014 download / write to disk",
    "category": "Native-only",
    "tags": ["generated: file", "generated: file_storage", "native-only"],
    "description": "Two generated-value kinds that touch the local filesystem: \"file\" downloads a URL and resolves to the local path it saved to, \"file_storage\" writes the field's value straight to a file (optionally appending). Both need real disk access, so they're native-only \u2014 the config below is real and copyable; Run stays disabled once it's loaded here.",
    "nativeOnly": true,
    "docsSlug": "generated-values",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "static_config": { "value": "{\"id\":42,\"report_url\":\"https://example.com/reports/42.pdf\"}" }
        },
        "model": {
          "object_config": {
            "fields": {
              "id": { "base_field": { "type": "int", "path": "id" } },
              "downloaded_path": {
                "base_field": {
                  "type": "string",
                  "path": "report_url",
                  "generated": { "file": { "url": "{PL}", "file_name": "report-{{{id}}}.pdf", "path": "/tmp/downloads", "config": { "method": "GET" } } }
                }
              },
              "audit_logged": {
                "base_field": {
                  "type": "string",
                  "path": "id",
                  "generated": { "file_storage": { "content": "processed id={PL}\n", "file_name": "audit.log", "path": "/tmp", "append": true } }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "id": "plugin-connector-native-only",
    "title": "Plugin connector & generated value",
    "category": "Native-only",
    "tags": ["plugin_connector_config", "generated: plugin", "native-only"],
    "description": "plugin_connector_config (as a data source) and generated.plugin (as a computed field) both load a compiled Go .so plugin via FITTER_PLUGINS. Go's native plugin loader isn't available under GOOS=js at all, so this only runs on the native binary \u2014 the config below is real and copyable; Run stays disabled once it's loaded here.",
    "nativeOnly": true,
    "docsSlug": "connectors",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "plugin_connector_config": { "name": "my_plugin", "config": { "api_key": "{{{FromEnv=MY_PLUGIN_KEY}}}" } }
        },
        "model": {
          "object_config": {
            "fields": {
              "value": { "base_field": { "type": "string", "path": "value" } },
              "computed": {
                "base_field": {
                  "type": "string",
                  "generated": { "plugin": { "name": "my_plugin", "config": { "op": "checksum" } } }
                }
              }
            }
          }
        }
      }
    }
  }
