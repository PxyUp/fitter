        },
        "model": {
          "array_config": {
            "root_path": "items",
            "item_config": {
              "fields": {
                "name": {
                  "first_of": [
                    { "base_field": { "type": "string", "path": "display_name" } },
                    { "base_field": { "type": "string", "path": "name" } },
                    { "base_field": { "type": "string", "path": "login" } }
                  ]
                }
              }
            }
          }
        }
      }
