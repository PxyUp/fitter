    "tags": ["file_config", "native-only"],
    "description": "file_config reads a connector's bytes from the local filesystem instead of the network \u2014 needs real disk access, so it can't run inside the browser sandbox this playground uses. The config below is real and copyable; Run stays disabled once it's loaded here. Use the native fitter_cli or MCP server.",
    "nativeOnly": true,
    "docsSlug": "connectors",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "file_config": { "path": "/etc/fitter/products.json", "use_formatting": false }
        },
        "model": {
          "object_config": {
            "fields": {
              "name": { "base_field": { "type": "string", "path": "name" } },
              "price": { "base_field": { "type": "float", "path": "price" } }
            }
          }
        }
      }
    }
