    "input": "",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "xpath",
          "static_config": {
            "value": "<html><body><ul class=\"list\"><li><a href=\"/a\">First</a></li><li><a href=\"/b\">Second</a></li></ul></body></html>"
          }
        },
        "model": {
          "array_config": {
            "root_path": "//li",
