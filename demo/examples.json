  {
    "id": "html-css",
    "title": "HTML scraping with CSS selectors",
    "category": "Parsers",
    "tags": ["parser: HTML", "connector: server (GET)", "live API"],
    "description": "response_type \"HTML\" parses the body with goquery, so field paths are CSS selectors; httpbin.org sends CORS headers so this works straight from the browser.",
    "counter": "html-css",
    "input": "",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "HTML",
          "url": "https://httpbin.org/html",
          "server_config": { "method": "GET" }
        },
        "model": {
          "object_config": {
            "fields": {
              "title": { "base_field": { "type": "string", "path": "h1" } },
              "excerpt": {
                "base_field": {
                  "type": "string",
                  "path": "div p",
                  "generated": { "calculated": { "type": "string", "expression": "trim(fRes[:120]) + \"\u2026\"" } }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "id": "xpath-html",
    "title": "HTML via XPath (offline)",
    "category": "Parsers",
    "tags": ["parser: xpath", "connector: static", "offline"],
    "description": "response_type \"xpath\" is usable on HTML documents too (not just XML) \u2014 same selector language, different content. Runs against a static HTML fragment.",
