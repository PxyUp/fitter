[
  {
    "id": "telegram-briefing",
    "title": "Telegram bot \u2192 scraped briefing to yourself",
    "category": "References & placeholders",
    "tags": ["references", "generated: model", "placeholders", "expressions", "connector: server (POST)"],
    "description": "Prefetches Hacker News + BTC price as references, then sends a Telegram message built from them via a nested generated.model fetch. Needs a real bot token + chat_id in the input to actually deliver (a placeholder token fails Telegram's CORS preflight and yields null).",
    "counter": "telegram-sends",
    "input": {
      "token": "123456:PASTE_YOUR_BOT_TOKEN",
      "chat_id": 123456789,
      "_hint": "create a bot via @BotFather, get your chat_id from @userinfobot; with the placeholder token the run yields null (invalid bots fail Telegram's CORS preflight) \u2014 paste real values and it delivers. Don't Share links with a real token inside"
    },
    "config": {
      "references": {
        "hn_top": {
          "connector_config": {
            "response_type": "json",
            "url": "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=5",
            "server_config": { "method": "GET", "timeout": 15 }
          },
          "model": {
            "array_config": {
              "root_path": "hits",
              "item_config": {
                "fields": {
                  "title": { "base_field": { "type": "string", "path": "title" } },
                  "points": { "base_field": { "type": "int", "path": "points" } }
                }
              }
            }
          }
        },
        "btc": {
          "connector_config": {
            "response_type": "json",
            "url": "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true",
            "server_config": { "method": "GET", "timeout": 15 }
          },
          "model": {
            "object_config": {
              "fields": {
                "usd": { "base_field": { "type": "int", "path": "bitcoin.usd" } },
                "trend": {
                  "base_field": {
                    "type": "float",
                    "path": "bitcoin.usd_24h_change",
                    "generated": { "calculated": { "type": "string", "expression": "fRes > 0 ? \"\ud83d\udcc8 up\" : \"\ud83d\udcc9 down\"" } }
                  }
                }
              }
            }
          }
        }
      },
      "item": {
        "connector_config": {
          "response_type": "json",
          "reference_config": { "name": "hn_top" }
        },
        "model": {
          "base_field": {
            "type": "object",
            "generated": {
              "model": {
                "type": "object",
                "connector_config": {
                  "response_type": "json",
                  "url": "https://api.telegram.org/bot{{{FromInput=token}}}/sendMessage",
                  "server_config": {
                    "method": "POST",
                    "headers": { "Content-Type": "application/json" },
                    "body": "{\"chat_id\":\"{{{FromInput=chat_id}}}\",\"link_preview_options\":{\"is_disabled\":true},\"text\":\"\ud83d\udce1 fitter briefing\\n\\n\u20bf BTC: ${{{RefName=btc usd}}} ({{{RefName=btc trend}}} last 24h)\\n\\n\ud83d\udda8 Hacker News front page:\\n{{{FromExp=join(map(fromJSON(fResJson), {string(#index+1) + '. ' + .title + ' \u2014 ' + string(.points) + ' pts'}), '\\n')}}}\"}"
                  }
                },
                "model": {
                  "object_config": {
                    "fields": {
                      "delivered": { "base_field": { "type": "boolean", "path": "ok" } },
                      "message_id": { "base_field": { "type": "int", "path": "result.message_id" } },
                      "to": { "base_field": { "type": "string", "path": "result.chat.first_name" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "id": "book-author-join",
    "title": "Book search \u2192 author join",
    "category": "Generated values",
    "tags": ["generated: model", "connector: server (GET)", "host limit", "live API"],
    "description": "Searches OpenLibrary by title, then for each result runs a nested fetch (generated.model) to look up the author's name and birth date. A host_request_limiter caps parallel requests to openlibrary.org.",
    "counter": "book-search",
    "input": "dune",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "url": "https://openlibrary.org/search.json?q={{{FromInput=.}}}&limit=3&fields=title,author_key,first_publish_year",
          "server_config": { "method": "GET" }
        },
        "model": {
          "array_config": {
            "root_path": "docs",
            "item_config": {
              "fields": {
                "title": { "base_field": { "type": "string", "path": "title" } },
                "year": { "base_field": { "type": "int", "path": "first_publish_year" } },
                "author": {
                  "base_field": {
                    "type": "object",
                    "generated": {
                      "model": {
                        "type": "object",
                        "connector_config": {
                          "response_type": "json",
                          "url": "https://openlibrary.org/authors/{{{FromExp=fromJSON(fRes).author_key[0]}}}.json",
                          "server_config": { "method": "GET" },
                          "null_on_error": true
                        },
                        "model": {
                          "object_config": {
                            "fields": {
                              "name": { "base_field": { "type": "string", "path": "name" } },
                              "born": { "base_field": { "type": "string", "path": "birth_date" } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "limits": { "host_request_limiter": { "openlibrary.org": 2 } }
    }
  },
  {
    "id": "conditional-fields",
    "title": "Conditional fields \u2014 filter & omit",
    "category": "Conditions",
    "tags": ["condition", "item_condition", "connector: static", "offline"],
    "description": "item_condition drops out-of-stock or zero-priced products before they reach the output; a per-field condition additionally omits discount_pct when it's not a positive number. Runs fully offline against a static payload.",
    "counter": "conditional-fields",
    "input": "",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "static_config": {
            "value": "{\"products\":[{\"title\":\"AeroBook 13\",\"price\":999,\"in_stock\":true,\"discount_pct\":15},{\"title\":\"Broken listing\",\"price\":0,\"in_stock\":true,\"discount_pct\":0},{\"title\":\"ZenPad 11\",\"price\":459,\"in_stock\":false,\"discount_pct\":20},{\"title\":\"NovaBook 15\",\"price\":1299,\"in_stock\":true,\"discount_pct\":0}]}"
          }
        },
        "model": {
          "array_config": {
            "root_path": "products",
            "item_condition": "fSrc.in_stock && fRes.price > 0",
            "item_config": {
              "fields": {
                "title": { "base_field": { "type": "string", "path": "title" } },
                "price": { "base_field": { "type": "float", "path": "price" } },
                "discount_pct": { "base_field": { "type": "float", "path": "discount_pct", "condition": "fRes > 0" } }
              }
            }
          }
        }
      }
    }
  },
  {
    "id": "static-json",
    "title": "Static JSON + a calculated field",
    "category": "Basics",
    "tags": ["connector: static", "generated: calculated", "offline"],
    "description": "The simplest possible config: parse a static JSON payload (no network at all), pick a few fields, and compute one via an expr-lang expression over the extracted value.",
    "counter": "static-json",
    "input": "",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "static_config": { "value": "{\"name\":\"fitter\",\"stars\":400,\"topics\":[\"scraping\",\"mcp\",\"ai-agents\"]}" }
        },
        "model": {
          "object_config": {
            "fields": {
              "project": { "base_field": { "type": "string", "path": "name" } },
              "stars": { "base_field": { "type": "int", "path": "stars" } },
              "first_topic": { "base_field": { "type": "string", "path": "topics.0" } },
              "shout": {
                "base_field": {
                  "type": "string",
                  "path": "name",
                  "generated": { "calculated": { "type": "string", "expression": "upper(fRes) + \"!\"" } }
                }
              }
            }
          }
        }
      }
    }
  },
