  {
    "id": "int-sequence",
    "title": "Generated sequence",
    "category": "Connectors",
    "tags": ["connector: int_sequence", "generated: calculated", "offline"],
    "description": "int_sequence_config generates [start, end) without any network call \u2014 useful for pagination loops driving a nested generated.model fetch per page.",
    "counter": "int-sequence",
    "input": "",
    "config": {
      "item": {
        "connector_config": {
          "response_type": "json",
          "int_sequence_config": { "start": 1, "end": 6, "step": 1 }
        },
        "model": {
          "array_config": {
            "root_path": "@this",
            "item_config": {
              "field": {
                "type": "int",
